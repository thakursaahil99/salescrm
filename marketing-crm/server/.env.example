NODE_ENV=production
PORT=5050
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/marketing-crm?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# This CRM's own Vercel frontend URL
CLIENT_URL=https://your-marketing-crm.vercel.app
# The Admin CRM shell's Vercel URL (comma-separated if more than one)
SHELL_URL=https://your-admin-crm-shell.vercel.app
