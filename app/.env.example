# Both point at the combined backend (one Render service serving both CRMs
# under /sales and /marketing) — see combined-server/. Leave VITE_API_URL as
# "/sales/api" and VITE_MARKETING_API_URL as "/marketing" for local dev
# behind a tunnel; set absolute URLs only once deployed on Vercel, since the
# frontend and backend are on different domains there.
VITE_API_URL=https://your-combined-backend.onrender.com/sales/api
VITE_MARKETING_API_URL=https://your-combined-backend.onrender.com/marketing
