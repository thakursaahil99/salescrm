# Leave as "/api" for local dev and tunnel-sharing (Vite proxies it to the
# backend). Set an absolute URL only when the API is deployed on another host —
# on Vercel this must be the Render backend's URL (no trailing slash), since
# the frontend and backend are on different domains in production.
VITE_API_URL=https://your-sales-crm-api.onrender.com/api
